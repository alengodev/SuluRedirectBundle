{
    "name": "alengo/redirect-bundle",
    "type": "symfony-bundle",
    "description": "CSV-driven permanent redirects for Symfony/Sulu sites: map legacy URLs to their new location at kernel.request.",
    "keywords": [
        "symfony",
        "sulu",
        "redirect",
        "migration",
        "seo"
    ],
    "homepage": "https://github.com/alengodev/RedirectBundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Huber-De Monte"
        }
    ],
    "require": {
        "php": "^8.2",
        "symfony/cache-contracts": "^3.0",
        "symfony/config": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/event-dispatcher": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/http-kernel": "^7.2"
    },
    "require-dev": {
        "php-cs-fixer/shim": "^3.93",
        "rector/rector": "^2.3"
    },
    "scripts": {
        "phpstan": "@php vendor/bin/phpstan analyze"
    },
    "autoload": {
        "psr-4": {
            "Alengo\\RedirectBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alengo\\RedirectBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    }
}
